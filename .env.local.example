# Per-developer local environment values. Copy to `.env.local` (gitignored) and
# fill in. Used by dev/test tooling; not read by the plugin at runtime.

# Local WordPress site URL (e.g. https://base.local). Used by Claude for
# smoke-testing and browser checks during development.
LOCAL_SITE_URL=

# WordPress admin credentials for authenticated local REST calls (Abilities API,
# etc.). Application password, not the login password. Revoke via wp-admin.
LOCAL_SITE_USER=
LOCAL_SITE_APP_PASSWORD=
