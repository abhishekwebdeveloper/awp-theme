{
	"php single line": {
		"prefix": "awp php single line",
		"body": ["<?php $0; ?>"],
		"scope": "html",
	},
	"php multi line": {
		"prefix": "awp php multi line",
		"body": ["<?php", "$0;", "?>"],
		"scope": "html",
	},
	"print_r": {
		"prefix": "awp debug print r",
		"body": [
			"<pre><?php echo htmlentities( print_r( ${1:\\$variable}, true ) ); ?></pre>$0",
		],
		"scope": "html",
	},
	"var_dump": {
		"prefix": "awp debug var dump",
		"body": [
			"<pre><?php echo htmlentities( var_dump( ${1:\\$variable} ) ); ?></pre>$0",
		],
		"scope": "html",
	},
	"if": {
		"prefix": "awp if",
		"body": ["<?php if ( ${1:\\$condition} ) : ?>", "\t$0", "<?php endif; ?>"],
		"scope": "html",
	},
	"foreach": {
		"prefix": "awp foreach",
		"body": [
			"<?php foreach ( ${1:\\$items} as ${2:\\$item} ) : ?>",
			"\t$0",
			"<?php endforeach; ?>",
		],
		"scope": "html",
	},
	"echo escape html": {
		"prefix": "awp echo escape html",
		"body": ["<?php echo esc_html( ${1:\\$string} ); ?>$0"],
		"scope": "html",
	},
	"echo escape html l10n": {
		"prefix": "awp echo escape html l10n",
		"body": [
			"<?php echo esc_html__( '${1:string}', 'awp-${2:textdomain}' ); ?>$0",
		],
		"scope": "html",
	},
	"echo escape attribute": {
		"prefix": "awp echo escape attribute",
		"body": ["<?php echo esc_attr( ${1:\\$string} ); ?>$0"],
		"scope": "html",
	},
	"echo escape attribute l10n": {
		"prefix": "awp echo escape attribute l10n",
		"body": [
			"<?php echo esc_attr__( '${1:string}', 'awp-${2:textdomain}' ); ?>$0",
		],
		"scope": "html",
	},
	"echo escape url": {
		"prefix": "awp echo escape url",
		"body": ["<?php echo esc_url( ${1:\\$string} ); ?>$0"],
		"scope": "html",
	},
	"echo kses post": {
		"prefix": "awp echo kses post",
		"body": ["<?php echo wp_kses_post( ${1:\\$string} ); ?>$0"],
		"scope": "html",
	},
	"echo kses with arguments": {
		"prefix": "awp echo kses with arguments",
		"body": ["<?php echo wp_kses( ${1:\\$string}, [ ${2:'br' => []} ] ); ?>$0"],
		"scope": "html",
	},
	"base view": {
		"prefix": "awp base view",
		"body": ["<?php Base::view( '${1:views/component}' ); ?>$0"],
		"scope": "html",
	},
	"base view with arguments": {
		"prefix": "awp base view with arguments",
		"body": [
			"<?php",
			"Base::view( '${1:views/component}', [",
			"\t'${2:key}' => '${3:value}',$0",
			"] );",
			"?>",
		],
		"scope": "html",
	},
	"get template part": {
		"prefix": "awp get template part",
		"body": ["<?php Base::get_template_part( '${1:button}' ); ?>$0"],
		"scope": "html",
	},
	"get template part with arguments": {
		"prefix": "awp get template part with arguments",
		"body": [
			"<?php",
			"Base::get_template_part( '${1:button}', [",
			"\t'${2:text}' => '${3:Button}',$0",
			"] );",
			"?>",
		],
		"scope": "html",
	},
}
